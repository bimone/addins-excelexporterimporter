<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Export-Import Excel - BIM One Revit add-in.
    Multi-version build. Pick the Revit version with the build configuration:
      Debug/Release R23  -> Revit 2023 (.NET Framework 4.8)
      Debug/Release R24  -> Revit 2024 (.NET Framework 4.8)
      Debug/Release R25  -> Revit 2025 (.NET 8)
      Debug/Release R26  -> Revit 2026 (.NET 8)
    Example:  dotnet build -c "Release R26"
  -->

  <PropertyGroup>
    <AssemblyName>ExcelExporterImporter</AssemblyName>
    <RootNamespace>ExcelExporterImporter</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy dependency assemblies next to the DLL so Revit can load them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationIcon>ImportExportExcel-Icon.ico</ApplicationIcon>
    <AssemblyTitle>ExcelExporterImporter</AssemblyTitle>
    <Product>Export-Import Excel</Product>
    <Description>Synchronize data back and forth between Revit and Excel.</Description>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <Configurations>Debug R23;Debug R24;Debug R25;Debug R26;Release R23;Release R24;Release R25;Release R26</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Release R26</Configuration>
  </PropertyGroup>

  <!-- Revit version / target framework selected by the configuration name -->
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <Optimize Condition="$(Configuration.StartsWith('Release'))">true</Optimize>
    <DebugType Condition="$(Configuration.StartsWith('Release'))">pdbonly</DebugType>
    <!-- Version reflects the Revit year plus the modernized-release number (.1) -->
    <AssemblyVersion>$(RevitVersion).1.0</AssemblyVersion>
    <FileVersion>$(RevitVersion).1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="4.5.3.2" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>

  <!-- Revit API (compile-only; Revit ships these assemblies at runtime) -->
  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2023.0.0" Condition="'$(RevitVersion)' == '2023'" ExcludeAssets="runtime" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.2.0" Condition="'$(RevitVersion)' == '2024'" ExcludeAssets="runtime" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0" Condition="'$(RevitVersion)' == '2025'" ExcludeAssets="runtime" />
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2026.0.0" Condition="'$(RevitVersion)' == '2026'" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- net8 needs the settings provider as a package (built into net48) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <!-- Lets net48 build without the .NET Framework targeting pack installed -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.fr.Designer.cs">
      <DependentUpon>Resources.fr.resx</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Views\ButtonUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\ButtonUserControl.Designer.cs">
      <DependentUpon>ButtonUserControl.cs</DependentUpon>
    </Compile>
    <Compile Update="Views\MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ProgressWindow.xaml.cs">
      <DependentUpon>ProgressWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Styles1.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Include="Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Page Include="Resources\Styles.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Views\MainWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Views\ProgressWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\TooIconNoNewVersionMiniGray.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconNewVersionMiniGray.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconNoConnectMiniGray.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconExitMiniGray.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconHelpMiniGray.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconSupportMiniGray.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconNewVersionMini.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconNoConnectMini.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ToolIconHelpMini.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\iconapp.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\IconButtonDownload.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\IconButtonExportMini.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\IconBiModeMini.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\IconUniModeMini.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\IconBiModeMiniBlue.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\IconUniModeMiniBlue.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Addin.addin">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Content>
    <Content Include="ImportExportExcel-Icon.ico" />
    <Content Include="MaterialAssetsSettings.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </Content>
    <Content Include="ParametersSettings.xml">
      <SubType>Designer</SubType>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\apps.gif">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\bimone.gif">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\button.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\mail.gif">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.fr.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.fr.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
      <!-- Embed into the fr satellite under the neutral base name so the Resources class'
           culture fallback finds French strings at runtime (was ...Resources.fr.resources,
           which the runtime never looked up, so French silently fell back to English). -->
      <Culture>fr</Culture>
      <LogicalName>ExcelExporterImporter.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ButtonUserControl.resx">
      <DependentUpon>ButtonUserControl.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Deploy to the local Revit add-ins folder on Debug builds only -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="$(Configuration.StartsWith('Debug'))">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <_DeployFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(ProjectDir)Addin.addin" DestinationFiles="$(RevitAddinsDir)\ExcelExporterImporter.addin" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_DeployFiles)" DestinationFiles="@(_DeployFiles->'$(RevitAddinsDir)\ExcelExporterImporter\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
